; Valid SPIR-V pointer copy. Reject early: the existing MSL interpolation analysis
; does not retain the source/member/component mapping through copied input pointers.
OpCapability Shader
OpCapability FragmentBarycentricKHR
OpCapability InterpolationFunction
OpExtension "SPV_KHR_fragment_shader_barycentric"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %persp %linear %color
OpExecutionMode %main OriginUpperLeft
OpDecorate %persp BuiltIn BaryCoordKHR
OpDecorate %linear BuiltIn BaryCoordNoPerspKHR
OpDecorate %color Location 0
%void = OpTypeVoid
%float = OpTypeFloat 32
%vec3 = OpTypeVector %float 3
%in3 = OpTypePointer Input %vec3
%out3 = OpTypePointer Output %vec3
%void_fn = OpTypeFunction %void
%persp = OpVariable %in3 Input
%linear = OpVariable %in3 Input
%color = OpVariable %out3 Output
%main = OpFunction %void None %void_fn
%m = OpLabel
%copied = OpCopyObject %in3 %linear
%n = OpExtInst %vec3 %glsl InterpolateAtCentroid %copied
%p = OpLoad %vec3 %persp
%result = OpFAdd %vec3 %p %n
OpStore %color %result
OpReturn
OpFunctionEnd
