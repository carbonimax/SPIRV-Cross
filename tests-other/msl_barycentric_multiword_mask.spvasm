; Valid Vulkan SampleMask layout that cannot fit Metal's single uint sample_mask.
OpCapability Shader
OpCapability FragmentBarycentricKHR
OpExtension "SPV_KHR_fragment_shader_barycentric"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %inputs %color
OpExecutionMode %main OriginUpperLeft
OpDecorate %block Block
OpMemberDecorate %block 0 BuiltIn BaryCoordKHR
OpMemberDecorate %block 1 BuiltIn SampleMask
OpDecorate %color Location 0
%void = OpTypeVoid
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%vec3 = OpTypeVector %float 3
%one = OpConstant %uint 1
%two = OpConstant %uint 2
%mask = OpTypeArray %uint %two
%block = OpTypeStruct %vec3 %mask
%inblock = OpTypePointer Input %block
%inu = OpTypePointer Input %uint
%outf = OpTypePointer Output %float
%fn = OpTypeFunction %void
%inputs = OpVariable %inblock Input
%color = OpVariable %outf Output
%main = OpFunction %void None %fn
%entry = OpLabel
%ptr = OpAccessChain %inu %inputs %one %one
%value = OpLoad %uint %ptr
%f = OpConvertUToF %float %value
OpStore %color %f
OpReturn
OpFunctionEnd
